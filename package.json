{
  "name": "dsh-git-commit-panel",
  "version": "0.1.0",
  "private": false,
  "description": "DSH web GUI plugin: a floating commit panel that appears when a workspace git repository has unstaged changes, with a hand-written or AI-generated commit message and commit / commit-and-push actions.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.map",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "src",
    "scripts",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:client && npm run build:host",
    "build:client": "node scripts/build.mjs",
    "build:host": "tsc -p tsconfig.json && node scripts/build-host.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:bundle": "node scripts/check-bundle.mjs",
    "verify": "npm run typecheck && npm run build && npm run check:bundle",
    "verify:panel": "node scripts/verify-panel.mjs",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "verify:generate": "node scripts/verify-generate.mjs",
    "verify:failure": "node scripts/verify-failure.mjs",
    "verify:theme": "node scripts/verify-theme.mjs",
    "prepare": "node scripts/build.mjs && node scripts/build-host.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.1",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
